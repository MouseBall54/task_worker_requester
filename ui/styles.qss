/* Brighter operator style for RabbitMQ task tracker */
QWidget {
    background-color: transparent;
    color: #edf4fb;
    font-family: "Segoe UI Variable Text", "Segoe UI", "Malgun Gothic", "Noto Sans KR";
    font-size: 13px;
}

QMainWindow,
QWidget#appRoot {
    background-color: #111827;
}

QMenuBar {
    background-color: #1a2335;
    color: #edf4fb;
    padding: 3px 8px;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 10px;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background-color: #2c3f5c;
}

QMenu {
    background-color: #223049;
    border: 1px solid #3b4f6f;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 24px 7px 12px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #2f5f9e;
}

QFrame#leftPanel,
QGroupBox {
    background-color: #1b2639;
    border: 1px solid #33445f;
    border-radius: 12px;
}

QFrame#statusSidebar {
    background-color: transparent;
    border: none;
}

QGroupBox {
    margin-top: 8px;
    padding-top: 14px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 4px;
    color: #e6eef8;
}

QLabel#panelTitle {
    font-size: 14px;
    font-weight: 600;
    color: #7dd3fc;
    padding: 2px 2px 0 2px;
}

QLabel#subPanelTitle {
    font-size: 12px;
    font-weight: 600;
    color: #9bdcff;
    padding: 2px 2px 0 2px;
}

QLabel#connectionStatus {
    border-radius: 8px;
    padding: 8px 11px;
    background-color: #26364d;
    color: #edf4fb;
}

QLabel#queueMetricsLabel {
    color: #d8e3ef;
    font-size: 12px;
    padding-left: 2px;
}

QLabel#connectionStatus[state="connected"] {
    background-color: #166534;
    color: #dcfce7;
}

QLabel#connectionStatus[state="disconnected"] {
    background-color: #991b1b;
    color: #fee2e2;
}

QPushButton {
    background-color: #2563eb;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 8px 13px;
    min-height: 18px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #3b82f6;
}

QPushButton:pressed {
    background-color: #1d4ed8;
}

QPushButton:disabled {
    background-color: #475569;
    color: #cbd5e1;
}

QLineEdit,
QComboBox,
QTextEdit,
QPlainTextEdit,
QTreeView,
QListWidget,
QTextBrowser {
    background-color: #111b2d;
    border: 1px solid #3a4b66;
    border-radius: 8px;
    padding: 7px;
    selection-background-color: #2563eb;
    selection-color: #eff6ff;
}

QLineEdit:focus,
QComboBox:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QTreeView:focus,
QTableView:focus {
    border-color: #60a5fa;
}

QComboBox QAbstractItemView {
    background-color: #111b2d;
    border: 1px solid #3a4b66;
    selection-background-color: #2f5f9e;
    selection-color: #eff6ff;
    outline: none;
    padding: 4px;
}

QListWidget#helpTopicList::item {
    padding: 9px 10px;
    margin: 2px;
    border-radius: 6px;
}

QListWidget#helpTopicList::item:hover {
    background-color: #29476b;
}

QListWidget#helpTopicList::item:selected {
    background-color: #2f5f9e;
    color: #eff6ff;
}

QLabel#helpMatchLabel {
    color: #d8e3ef;
    background-color: #1d2a3f;
    border: 1px solid #34445f;
    border-radius: 8px;
    padding: 7px 9px;
}

QTreeView#folderTree {
    background-color: #111b2d;
    border: 1px solid #3a4b66;
    border-radius: 10px;
    alternate-background-color: #17243a;
    padding: 4px 3px;
}

QTreeView#folderTree::item {
    height: 26px;
    margin: 1px 2px;
    padding: 0 8px;
    border: none;
    border-radius: 6px;
}

QTreeView#folderTree::item:hover {
    background-color: #29476b;
}

QTreeView#folderTree::item:selected {
    background-color: #2f5f9e;
    color: #eff6ff;
}

QTreeView#folderTree::item:selected:active,
QTreeView#folderTree::item:selected:!active {
    background-color: #2f5f9e;
    color: #eff6ff;
}

QTreeView#folderTree::branch {
    background: transparent;
}

QToolButton#statusSidebarToggle {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 4px;
    min-width: 30px;
    min-height: 30px;
}

QToolButton#recipeMultiButton {
    background-color: #26364d;
    color: #edf4fb;
    border: 1px solid #3a4b66;
    border-radius: 8px;
    padding: 6px 10px;
    min-height: 22px;
    text-align: left;
}

QToolButton#recipeMultiButton:hover,
QToolButton#recipeMultiButton:checked {
    background-color: #315075;
    border-color: #60a5fa;
}

QToolButton#recipeMultiButton:disabled {
    background-color: #253044;
    color: #8290a4;
    border-color: #344054;
}

QLabel#recipePathsTitle {
    color: #cbd5e1;
    font-weight: 600;
    padding-top: 2px;
}

QFrame#recipePathsPanel {
    background-color: #111b2d;
    border: 1px solid #34445f;
    border-radius: 8px;
}

QFrame#recipePathRow {
    background-color: #17243a;
    border: 1px solid #2d3c55;
    border-radius: 6px;
}

QLabel#recipePathAlias {
    color: #dbeafe;
    font-weight: 600;
}

QLabel#recipePathValue {
    color: #aebed2;
}

QLabel#recipePathEmpty {
    color: #8290a4;
    padding: 8px;
}

QToolButton#statusSidebarToggle:hover {
    background-color: rgba(59, 130, 246, 0.24);
    border-color: rgba(125, 211, 252, 0.6);
}

QToolButton#statusSidebarToggle:pressed,
QToolButton#statusSidebarToggle:checked {
    background-color: rgba(59, 130, 246, 0.36);
    border-color: rgba(186, 230, 253, 0.78);
}

QHeaderView::section {
    background-color: #172237;
    color: #dbeafe;
    border: 0;
    border-bottom: 1px solid #34445f;
    padding: 8px;
    font-weight: 600;
}

QTableView {
    background-color: #111b2d;
    border: 1px solid #3a4b66;
    border-radius: 8px;
    selection-background-color: #2f5f9e;
    selection-color: #eff6ff;
    gridline-color: #2d3c55;
    alternate-background-color: #17243a;
    padding: 0px;
}

QTableView::item {
    padding: 7px 9px;
}

QTabWidget#bottomTabs::pane {
    border: 1px solid #3a4b66;
    border-radius: 10px;
    background-color: #111b2d;
    top: -1px;
}

QTabWidget#bottomTabs QTabBar::tab {
    background-color: #1d2a3f;
    color: #b7c5d8;
    border: 1px solid #34445f;
    border-bottom: none;
    padding: 7px 14px;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-width: 88px;
}

QTabWidget#bottomTabs QTabBar::tab:selected {
    background-color: #2f5f9e;
    color: #eff6ff;
    border-color: #60a5fa;
}

QTabWidget#bottomTabs QTabBar::tab:hover:!selected {
    background-color: #243754;
    color: #e2e8f0;
}

QProgressBar {
    border: 1px solid #3a4b66;
    border-radius: 8px;
    text-align: center;
    background-color: #111b2d;
    color: #edf4fb;
}

QProgressBar::chunk {
    background-color: #38bdf8;
    border-radius: 7px;
}

QSplitter::handle {
    background: #34445f;
    border-radius: 4px;
}

QSplitter::handle:horizontal {
    width: 8px;
    margin: 2px 0;
}

QSplitter::handle:horizontal:hover {
    background: #38bdf8;
}

QScrollBar:vertical {
    background: rgba(15, 23, 42, 0.18);
    width: 16px;
    margin: 3px 3px 3px 3px;
    border: none;
    border-radius: 8px;
}

QScrollBar::handle:vertical {
    background: rgba(125, 211, 252, 0.5);
    min-height: 42px;
    border-radius: 8px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(186, 230, 253, 0.76);
}

QScrollBar::handle:vertical:pressed {
    background: rgba(224, 242, 254, 0.9);
}

QScrollBar:horizontal {
    background: rgba(15, 23, 42, 0.18);
    height: 16px;
    margin: 3px 3px 3px 3px;
    border: none;
    border-radius: 8px;
}

QScrollBar::handle:horizontal {
    background: rgba(125, 211, 252, 0.5);
    min-width: 42px;
    border-radius: 8px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(186, 230, 253, 0.76);
}

QScrollBar::handle:horizontal:pressed {
    background: rgba(224, 242, 254, 0.9);
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
    border: none;
    width: 0px;
    height: 0px;
}
